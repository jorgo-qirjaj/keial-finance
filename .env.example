# Contact form (api/contact.ts). Set these in Vercel → Project → Settings → Environment Variables.

# API key from https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# Inbox(es) that receive website enquiries, comma-separated.
CONTACT_TO="keial.auditing@gmail.com"

# Optional. Sender address on a domain verified in Resend, e.g. "KEI-AL Website <web@kei.al>".
# If left unset, Resend's test sender is used, which only delivers to the Resend account owner's email.
CONTACT_FROM=""
